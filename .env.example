# URL canonique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://alo-maroc.ma

# Numéro WhatsApp au format international sans "+"
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000

# Seuil de livraison gratuite en MAD (0 = barre de progression désactivée)
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=500

# Tracking — laisser vide pour désactiver le tag correspondant
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# ATTENTION : NEXT_PUBLIC_SITE_URL doit inclure le schéma (https://).
# Une valeur comme "alo-maroc.ma" est corrigée automatiquement, mais une valeur
# inexploitable retombe sur le domaine par défaut.
